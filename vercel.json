{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/chat.js": {
      "includeFiles": "content/**",
      "maxDuration": 30
    },
    "api/livrable.js": {
      "maxDuration": 30
    },
    "api/stats.js": {
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/livrables/(.*)",
      "headers": [
        { "key": "Content-Disposition", "value": "inline" }
      ]
    }
  ]
}
