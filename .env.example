# Copie ce fichier en .env.local pour le dev local : cp .env.example .env.local
# NE JAMAIS commiter .env.local (il est dans .gitignore).
# En production, configure cette variable dans Vercel > Project > Settings > Environment Variables.

# Cle API Anthropic (https://console.anthropic.com/ > API Keys)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optionnel : surcharge du modele (defaut : claude-sonnet-4-6)
# CLAUDE_MODEL=claude-sonnet-4-6

# Optionnel : rate limiting (defauts : 12 requetes / 60000 ms par IP)
# RATE_LIMIT_MAX=12
# RATE_LIMIT_WINDOW_MS=60000

# Optionnel : activite GitHub publique injectee dans le corpus
# GITHUB_USERNAME=alexdesailly-ui      # compte dont on lit les depots publics
# GITHUB_CACHE_MS=1800000              # duree du cache memoire (defaut 30 min)
# GITHUB_TOKEN=ghp_xxx                 # token (lecture publique) pour une limite de taux plus haute. Facultatif.
