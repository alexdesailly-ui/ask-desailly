# Copie ce fichier en .env.local pour le dev local : cp .env.example .env.local
# NE JAMAIS commiter .env.local (il est dans .gitignore).
# En production, configure cette variable dans Vercel > Project > Settings > Environment Variables.

# Cle API Anthropic (https://console.anthropic.com/ > API Keys)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optionnel : surcharge du modele (defaut : claude-sonnet-5)
# CLAUDE_MODEL=claude-sonnet-5

# Optionnel : rate limiting (defauts : 12 requetes / 60000 ms par IP)
# RATE_LIMIT_MAX=12
# RATE_LIMIT_WINDOW_MS=60000

# Optionnel : activite GitHub publique injectee dans le corpus
# GITHUB_USERNAME=alexdesailly-ui      # compte dont on lit les depots publics
# GITHUB_CACHE_MS=1800000              # duree du cache memoire (defaut 30 min)
# GITHUB_TOKEN=ghp_xxx                 # token (lecture publique) pour une limite de taux plus haute. Facultatif.

# --- Statistiques (qui vient, ce qu'on demande) : tableau de bord /admin ---
# Sans DATABASE_URL, tout est desactive : le site fonctionne comme avant.
# DATABASE_URL=postgres://...        # Postgres Neon (Vercel > Storage > Neon : ajoute la variable automatiquement)
# ADMIN_TOKEN=un-long-secret-aleatoire   # mot de passe du tableau de bord /admin (obligatoire pour y acceder)
# IP_HASH_SALT=un-autre-secret           # sel du hash d'IP (l'IP n'est jamais stockee en clair)
# CLASSIFIER_MODEL=claude-haiku-4-5-20251001  # petit modele qui classe theme / intention / lead

# --- Google Drive = source DYNAMIQUE des livrables (lu en production) ---
# TOUT ce qui est dans ce dossier (sous-dossiers compris) est PUBLIC. Garde tes
# documents prives en dehors. Sans ces 2 variables : repli sur content/livrables/.
# DRIVE_FOLDER_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz  # id du dossier Drive public (dans son URL)
# GOOGLE_SERVICE_ACCOUNT_JSON=...              # JSON du compte de service : contenu brut, base64, ou chemin (dev local)
#                                              # Sur Vercel : colle le JSON (ou son base64) dans la variable.
# DRIVE_CACHE_MS=600000                        # duree du cache memoire (defaut 10 min)
